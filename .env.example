# PostgreSQL
POSTGRES_USER=webhook_engine
POSTGRES_PASSWORD=webhook_engine_password
POSTGRES_DB=webhook_engine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Worker
WORKER_CONCURRENCY=50
MAX_RETRY_ATTEMPTS=5
BASE_RETRY_DELAY_SECONDS=2.0
MAX_RETRY_DELAY_SECONDS=60.0
HTTP_TIMEOUT_SECONDS=3.0
STREAM_NAME=webhooks:events:stream
CONSUMER_GROUP=engine_workers_group
RETRY_ZSET_KEY=webhooks:retry:zset
SCHEDULER_POLL_INTERVAL_SECONDS=0.5
STREAM_BATCH_SIZE=10
STREAM_BLOCK_MS=2000

# App
APP_ENV=development
LOG_LEVEL=INFO
